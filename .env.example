# Required
YOUTUBE_API_KEY=your_youtube_api_key
GEMINI_API_KEY=your_gemini_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
CHANNEL_IDS=UCxxxx,UCyyyy,UCzzzz

# Optional
LOOKBACK_HOURS=24
MAX_VIDEOS_PER_CHANNEL=2
MAX_TOTAL_VIDEOS=4
MIN_DURATION_SECONDS=180
YOUTUBE_CHANNEL_DELAY_MS=1500
YOUTUBE_MAX_RETRIES=5
# Max Gemini API calls per minute (check yours at aistudio.google.com → Rate limits)
GEMINI_RPM=4
GEMINI_CALL_DELAY_MS=0
GEMINI_FINAL_DELAY_MS=0
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_SECONDS=3
VIDEO_SUMMARY_MODEL=gemini-2.5-flash-lite
VIDEO_SUMMARY_FALLBACK_MODEL=gemini-2.5-flash-lite
DIGEST_MODEL=gemini-2.5-flash-lite
DIGEST_FALLBACK_MODEL=gemini-2.5-flash-lite